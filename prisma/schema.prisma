generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PREMIUM
}

enum PremiumRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VocabularyReportStatus {
  OPEN
  RESOLVED
}

enum VocabularyReportType {
  WORD
  TRANSLATION
}

enum ShopItemType {
  BADGE
  THEME
  BOOSTER
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String
  firstName        String?
  lastName         String?
  birthDate        DateTime? @db.Date
  avatarUrl        String?   @db.Text
  plan             Plan      @default(FREE)
  isAdmin          Boolean   @default(false)
  isTestUser       Boolean   @default(false)
  onboardingComplete Boolean  @default(false)
  xp               Int       @default(0)
  streakCount      Int       @default(0)
  streakUpdatedAt  DateTime?
  showFullName     Boolean   @default(false)
  language         String    @default("de")
  learningLanguage String    @default("pt-br")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions          Session[]
  premiumRequests   PremiumRequest[]
  vocabularyReports VocabularyReport[]
  levelProgress     UserLevelProgress[]
  badges            UserBadge[]
  purchases         UserPurchase[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Chapter {
  id                String             @id @default(cuid())
  title             String
  description       String?            @db.Text
  order             Int
  language          String             @default("en") // Target language (what users learn) - ISO code like "de", "en", "pt-br"
  sourceLanguage    String             @default("de") // Source language (interface language)
  targetLanguage    String             @default("en") // Target language (what to learn) - same as language for backwards compatibility
  isFeatured        Boolean            @default(false) // Show as promoted on dashboard
  isLocked          Boolean            @default(false) // Show as "coming soon"
  unlocksAt         DateTime? // Automatic unlock date/time for scheduled release
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  subchapters       Subchapter[]
  vocabularyReports VocabularyReport[]

  @@unique([sourceLanguage, targetLanguage, order])
}

model Subchapter {
  id                String             @id @default(cuid())
  chapterId         String
  title             String
  description       String?            @db.Text
  order             Int
  isLocked          Boolean            @default(false) // Show as "coming soon"
  unlocksAt         DateTime? // Automatic unlock date/time for scheduled release
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  chapter           Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  vocabulary        Vocabulary[]
  vocabularyReports VocabularyReport[]

  @@unique([chapterId, order])
  @@index([chapterId])
}

model Vocabulary {
  id                String             @id @default(cuid())
  subchapterId      String
  word              String
  translation       String
  example           String?            @db.Text
  translatedExample String?            @db.Text
  order             Int
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  subchapter        Subchapter         @relation(fields: [subchapterId], references: [id], onDelete: Cascade)
  vocabularyReports VocabularyReport[]

  @@index([subchapterId])
}

model VocabularyReport {
  id             String                 @id @default(cuid())
  userId         String
  vocabularyId   String
  chapterId      String
  subchapterId   String
  issueType      VocabularyReportType
  reason         String
  comment        String?
  word           String
  translation    String
  sourceLanguage String
  targetLanguage String
  status         VocabularyReportStatus @default(OPEN)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary     Vocabulary             @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  chapter        Chapter                @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  subchapter     Subchapter             @relation(fields: [subchapterId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vocabularyId])
  @@index([status])
}

model PremiumRequest {
  id        String               @id @default(cuid())
  userId    String
  reason    String?
  message   String?
  status    PremiumRequestStatus @default(PENDING)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PremiumSettings {
  id String @id @default("default")

  // Daily limits for chapters
  maxChaptersPerDayFree    Int @default(2)
  maxChaptersPerDayPremium Int @default(-1) // -1 means unlimited

  // Daily limits for subchapters
  maxSubchaptersPerDayFree    Int @default(5)
  maxSubchaptersPerDayPremium Int @default(-1) // -1 means unlimited

  // Total chapter access for free users
  maxChaptersTotalFree Int @default(3)

  // Leaderboard access
  canSeeLeaderboardFree    Boolean @default(false)
  canSeeLeaderboardPremium Boolean @default(true)

  // XP multiplier for premium users (1.0 = normal, 1.5 = 50% more)
  xpMultiplierPremium Float @default(1.5)

  // Other features
  maxLessonsPerDayFree    Int @default(50)
  maxLessonsPerDayPremium Int @default(-1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShopItem {
  id          String         @id @default(cuid())
  name        String
  description String         @db.Text
  type        ShopItemType
  price       Int // Price in XP points
  icon        String // Emoji or icon identifier
  isActive    Boolean        @default(true) // Admin can disable items
  metadata    String?        @db.Text // JSON for additional item-specific data (colors, effects, etc.)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  purchases   UserPurchase[]

  @@index([type, isActive])
}

model UserPurchase {
  id          String   @id @default(cuid())
  userId      String
  shopItemId  String
  purchasedAt DateTime @default(now())
  equipped    Boolean  @default(false) // For items that can be equipped/displayed
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItem    ShopItem @relation(fields: [shopItemId], references: [id], onDelete: Cascade)

  @@unique([userId, shopItemId]) // User can only purchase each item once
  @@index([userId])
  @@index([shopItemId])
}

model LearningChapter {
  id         String          @id
  titleKey   String
  orderIndex Int
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  levels     LearningLevel[]
}

model LearningLevel {
  id         String             @id
  chapterId  String
  titleKey   String
  themeKey   String
  orderIndex Int
  requiredXp Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  chapter    LearningChapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  progress   UserLevelProgress[]

  @@index([chapterId])
}

model UserLevelProgress {
  id        String        @id
  userId    String
  levelId   String
  status    String        @default("LOCKED")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     LearningLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
  @@index([userId])
  @@index([levelId])
}

model Badge {
  id             String      @id
  titleKey       String
  descriptionKey String
  tier           String
  icon           String
  orderIndex     Int
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  users          UserBadge[]
}

model UserBadge {
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}
