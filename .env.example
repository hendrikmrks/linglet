# PostgreSQL Connection
DATABASE_URL="postgresql://lingletuser:your_secure_password@localhost:5432/linglet?schema=public"

# Authentication Secret (generate with: openssl rand -base64 32)
AUTH_SECRET="your_random_secret_here_min_32_characters"

# Application URL
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Node Environment
NODE_ENV="production"

# Optional: Database connection parameters for seed script
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="lingletuser"
DB_PASSWORD="your_secure_password"
DB_NAME="linglet"
